{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://driftzero.in/schemas/navigation-state-1.0.0.json",
  "title": "DriftZero NavigationState",
  "type": "object",
  "required": [
    "schema_version", "sequence", "timestamp_ns", "mode", "position", "motion",
    "uncertainty", "gnss_health", "map_match", "health", "provenance"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp_ns": {"type": "integer", "minimum": 0},
    "mode": {
      "type": "string",
      "enum": ["GNSS_FUSED", "GNSS_DEGRADED", "DEAD_RECKONING", "REACQUIRING", "LOW_CONFIDENCE"]
    },
    "position": {
      "type": "object",
      "required": ["latitude_deg", "longitude_deg"],
      "properties": {
        "latitude_deg": {"type": "number", "minimum": -90, "maximum": 90},
        "longitude_deg": {"type": "number", "minimum": -180, "maximum": 180},
        "altitude_m": {"type": "number"}
      },
      "additionalProperties": false
    },
    "motion": {
      "type": "object",
      "required": ["speed_mps", "heading_rad"],
      "properties": {
        "speed_mps": {"type": "number", "minimum": 0},
        "heading_rad": {"type": "number", "minimum": 0, "exclusiveMaximum": 6.283185307179586},
        "yaw_rate_radps": {"type": "number"}
      },
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "object",
      "required": ["horizontal_95_m", "heading_95_rad", "is_calibrated"],
      "properties": {
        "horizontal_95_m": {"type": "number", "minimum": 0},
        "heading_95_rad": {"type": "number", "minimum": 0},
        "is_calibrated": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "gnss_health": {
      "type": "object",
      "required": ["score", "last_trusted_fix_age_s", "risk_flags"],
      "properties": {
        "score": {"type": "number", "minimum": 0, "maximum": 1},
        "last_trusted_fix_age_s": {"type": "number", "minimum": 0},
        "risk_flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "map_match": {
      "type": "object",
      "required": ["status", "confidence"],
      "properties": {
        "status": {"type": "string", "enum": ["MATCHED", "AMBIGUOUS", "UNMATCHED", "NO_MAP"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "road_segment_id": {"type": "string"},
        "road_name": {"type": "string"}
      },
      "additionalProperties": false
    },
    "health": {
      "type": "object",
      "required": ["sensor_ok", "model_ok", "filter_ok", "map_ok", "flags"],
      "properties": {
        "sensor_ok": {"type": "boolean"},
        "model_ok": {"type": "boolean"},
        "filter_ok": {"type": "boolean"},
        "map_ok": {"type": "boolean"},
        "flags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["core_version", "config_hash"],
      "properties": {
        "core_version": {"type": "string"},
        "model_version": {"type": "string"},
        "map_package_id": {"type": "string"},
        "config_hash": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

